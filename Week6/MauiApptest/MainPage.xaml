<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApptest.MainPage"
             Title="RPN Calculator">

        <ScrollView Margin="20">

                <VerticalStackLayout Spacing="20"
                                     Padding="30">

                <!-- Display Text Field -->
                <Border Stroke="#512BD4"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="#A9A9A9"
                        Padding="15,10">
                        <Entry x:Name="DisplayEntry"
                               Text=""
                               FontSize="24"
                               FontFamily="Courier New"
                               HorizontalTextAlignment="Start"
                               VerticalTextAlignment="Center"
                               MinimumHeightRequest="80"
                               Completed ="CalculateButton_Clicked"/>
                </Border>

                        <!-- Result Display -->
                        <Border Stroke="#2E8B57"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 5"
                                BackgroundColor="#A9A9A9"
                                Padding="15,10"
                                IsVisible="{Binding IsResultVisible}">
                                <Label x:Name="ResultLabel"
                                       Text=""
                                       FontSize="20"
                                       FontFamily="Courier New"
                                       HorizontalTextAlignment="Start"
                                       VerticalTextAlignment="Center"
                                       TextColor="#2E8B57"
                                       LineBreakMode="WordWrap"/>
                        </Border>

                <!-- Numpad Grid -->
                <Grid ColumnDefinitions="*,*,*,*,*,*"
                      RowDefinitions="*,*,*,*,*,*"
                      RowSpacing="10"
                      ColumnSpacing="10">

                                <!-- Row 1 -->
                                <Button Grid.Row="0"
                                        Grid.Column="0"
                                        Text="7"
                                        Clicked="NumberButton_Clicked"/>
                                <Button Grid.Row="0"
                                        Grid.Column="1"
                                        Text="8"
                                        Clicked="NumberButton_Clicked"/>
                                <Button Grid.Row="0"
                                        Grid.Column="2"
                                        Text="9"
                                        Clicked="NumberButton_Clicked"/>
                                <Button Grid.Row="0"
                                        Grid.Column="3"
                                        Text="+"
                                        Clicked="OperatorButton_Clicked"
                                        BackgroundColor="#4A90E2"
                                        TextColor="White"/>
                                <Button Grid.Row="0"
                                        Grid.Column="4"
                                        Text="sqrt"
                                        Clicked="FunctionButton_Clicked"
                                        BackgroundColor="#FFA500"
                                        TextColor="White"
                                        FontSize="14"/>
                                <Button Grid.Row="0"
                                        Grid.Column="5"
                                        Text="round"
                                        Clicked="FunctionButton_Clicked"
                                        BackgroundColor="#FFA500"
                                        TextColor="White"
                                        FontSize="14"/>

                                <!-- Row 2 -->
                                <Button Grid.Row="1"
                                        Grid.Column="0"
                                        Text="4"
                                        Clicked="NumberButton_Clicked"/>
                                <Button Grid.Row="1"
                                        Grid.Column="1"
                                        Text="5"
                                        Clicked="NumberButton_Clicked"/>
                                <Button Grid.Row="1"
                                        Grid.Column="2"
                                        Text="6"
                                        Clicked="NumberButton_Clicked"/>
                                <Button Grid.Row="1"
                                        Grid.Column="3"
                                        Text="-"
                                        Clicked="OperatorButton_Clicked"
                                        BackgroundColor="#4A90E2"
                                        TextColor="White"/>
                                <Button Grid.Row="1"
                                        Grid.Column="4"
                                        Text="exp"
                                        Clicked="FunctionButton_Clicked"
                                        BackgroundColor="#FFA500"
                                        TextColor="White"
                                        FontSize="14"/>
                                <Button Grid.Row="1"
                                        Grid.Column="5"
                                        Text="mod"
                                        Clicked="FunctionButton_Clicked"
                                        BackgroundColor="#FFA500"
                                        TextColor="White"
                                        FontSize="14"/>

                                <!-- Row 3 -->
                                <Button Grid.Row="2"
                                        Grid.Column="0"
                                        Text="1"
                                        Clicked="NumberButton_Clicked"/>
                                <Button Grid.Row="2"
                                        Grid.Column="1"
                                        Text="2"
                                        Clicked="NumberButton_Clicked"/>
                                <Button Grid.Row="2"
                                        Grid.Column="2"
                                        Text="3"
                                        Clicked="NumberButton_Clicked"/>
                                <Button Grid.Row="2"
                                        Grid.Column="3"
                                        Text="*"
                                        Clicked="OperatorButton_Clicked"
                                        BackgroundColor="#4A90E2"
                                        TextColor="White"/>
                                <Button Grid.Row="2"
                                        Grid.Column="4"
                                        Text="asin"
                                        Clicked="FunctionButton_Clicked"
                                        BackgroundColor="#FFA500"
                                        TextColor="White"
                                        FontSize="14"/>
                                <Button Grid.Row="2"
                                        Grid.Column="5"
                                        Text="sin"
                                        Clicked="FunctionButton_Clicked"
                                        BackgroundColor="#FFA500"
                                        TextColor="White"
                                        FontSize="14"/>

                                <!-- Row 4 -->
                                <Button Grid.Row="3"
                                        Grid.Column="0"
                                        Text="0"
                                        Clicked="NumberButton_Clicked"/>
                                <Button Grid.Row="3"
                                        Grid.Column="1"
                                        Text=","
                                        Clicked="DecimalButton_Clicked"/>
                                <Button Grid.Row="3"
                                        Grid.Column="2"
                                        Text="⌫"
                                        Clicked="BackspaceButton_Clicked"
                                        BackgroundColor="#FF6B6B"
                                        TextColor="White"/>
                                <Button Grid.Row="3"
                                        Grid.Column="3"
                                        Text="/"
                                        Clicked="OperatorButton_Clicked"
                                        BackgroundColor="#4A90E2"
                                        TextColor="White"/>
                                <Button Grid.Row="3"
                                        Grid.Column="4"
                                        Text="acos"
                                        Clicked="OperatorButton_Clicked"
                                        BackgroundColor="#FFA500"
                                        TextColor="White"
                                        FontSize="14"/>
                                <Button Grid.Row="3"
                                        Grid.Column="5"
                                        Text="cos"
                                        Clicked="FunctionButton_Clicked"
                                        BackgroundColor="#FFA500"
                                        TextColor="White"
                                        FontSize="14"/>

                                <!-- Row 5: Control Buttons -->
                                <Button Grid.Row="4"
                                        Grid.Column="0"
                                        Text="Space"
                                        Clicked="SpaceButton_Clicked"
                                        BackgroundColor="#50C878"
                                        TextColor="White"/>
                                <Button Grid.Row="4"
                                        Grid.Column="1"
                                        Text="Clear"
                                        Clicked="ClearButton_Clicked"
                                        BackgroundColor="#512BD4"
                                        TextColor="White"/>
                                <Button Grid.Row="4"
                                        Grid.Column="2"
                                        Text="="
                                        Clicked="CalculateButton_Clicked"
                                        BackgroundColor="#9C27B0"
                                        TextColor="White"/>
                                <Button Grid.Row="4"
                                        Grid.Column="3"
                                        Text="^"
                                        Clicked="FunctionButton_Clicked"
                                        BackgroundColor="#4A90E2"
                                        TextColor="White"
                                        FontSize="14"/>
                                <Button Grid.Row="4"
                                        Grid.Column="4"
                                        Text="atan"
                                        Clicked="FunctionButton_Clicked"
                                        BackgroundColor="#FFA500"
                                        TextColor="White"
                                        FontSize="14"/>
                                <Button Grid.Row="4"
                                        Grid.Column="5"
                                        Text="tan"
                                        Clicked="FunctionButton_Clicked"
                                        BackgroundColor="#FFA500"
                                        TextColor="White"
                                        FontSize="14"/>

                                <!-- Row 6: help -->
                                <Button Grid.Row="5"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="3"
                                        Text="Oprator Details"
                                        Clicked="OperatorsButton_Clicked"
                                        BackgroundColor="#512BD4"
                                        TextColor="White"/>

                                <Button Grid.Row="5"
                                        Grid.Column="3"
                                        Grid.ColumnSpan="3"
                                        Text="Show Help"
                                        Clicked="ShowHelp_Clicked"
                                        BackgroundColor="#512BD4"
                                        TextColor="White"/>

                </Grid>

                </VerticalStackLayout>

        </ScrollView>
</ContentPage>
